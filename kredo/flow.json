{
  "name": "kredo",
  "version": "1.26.0",
  "iteration": "seed",
  "start": "goal",
  "rules": "FLOW.{lang}.md",
  "stages": [
    "K",
    "R",
    "E",
    "D",
    "O"
  ],
  "languages": "languages",
  "layout": {
    "stageArtifact": "metamodel/{iteration}/{stage}/artifact.md",
    "startArtifact": "goal/artifact.md",
    "task": "metamodel/{iteration}/O/{author}/tasks/{n}/task.jsonl",
    "taskChat": "metamodel/{iteration}/O/{author}/tasks/{n}/{role}.jsonl",
    "experiment": "metamodel/{iteration}/E/{author}/experiments/{n}/experiment.jsonl",
    "experimentChat": "metamodel/{iteration}/E/{author}/experiments/{n}/chat.jsonl",
    "experimentList": "metamodel/{iteration}/E/experiments.json"
  },
  "access": "readonly",
  "tasks": {
    "stage": "O",
    "spec": "D"
  },
  "roles": {
    "coder": {
      "access": "readonly",
      "rules": "roles/coder.{lang}.md"
    },
    "auditor": {
      "access": "readonly",
      "rules": "roles/auditor.{lang}.md"
    },
    "apply": {
      "access": "readwrite",
      "rules": "roles/apply.{lang}.md"
    },
    "experimenter": {
      "access": "readwrite",
      "rules": "roles/experimenter.{lang}.md"
    }
  },
  "offStage": "[OFFTOP]",
  "commands": {
    "back": "/-1",
    "next": "/+1",
    "task": "/task",
    "coder": "/coder",
    "audit": "/audit",
    "apply": "/apply",
    "fail": "/fail",
    "done": "/done",
    "drop": "/drop",
    "run": "/run"
  },
  "chatCommands": {
    "stage": [
      "add",
      "replace",
      "next",
      "back",
      "model",
      "short",
      "iteration"
    ],
    "tasks": [
      "add",
      "replace",
      "next",
      "back",
      "model",
      "task",
      "coder",
      "drop",
      "apply",
      "iteration"
    ],
    "coder": [
      "audit",
      "apply",
      "fail",
      "done",
      "model",
      "drop"
    ],
    "auditor": [
      "coder",
      "fail",
      "done",
      "model",
      "drop"
    ],
    "apply": [
      "audit",
      "fail",
      "done",
      "model",
      "drop"
    ],
    "experiments": [
      "add",
      "replace",
      "next",
      "back",
      "model",
      "run",
      "drop",
      "iteration"
    ],
    "experimenter": [
      "fail",
      "done",
      "drop",
      "model"
    ]
  },
  "experiments": {
    "stage": "E",
    "spec": "R",
    "role": "experimenter",
    "text": "toExperimenter",
    "list": "experimentList"
  },
  "tests": {
    "file": "tests/run.sh",
    "run": [
      "bash",
      "tests/run.sh"
    ],
    "timeout": 300000,
    "tail": 60,
    "text": "toApplyTests"
  },
  "auto": {
    "diff": "diff",
    "ok": "OK",
    "okTrim": "[.!\\s]*",
    "okLastLine": true
  }
}
